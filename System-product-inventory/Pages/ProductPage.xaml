<Page x:Class="System_product_inventory.Pages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:System_product_inventory.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <TextBox x:Name="SearchBox" Width="250" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center"/>

            <Button x:Name="SearchButton" Content="Поиск" Width="100" Height="30" Margin="0,0,20,0" Click="SearchButton_Click"/>

            <Button x:Name="AddButton" Content="Добавить" Width="100" Height="30" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Редактировать" Width="120" Height="30" Margin="0,0,10,0" Background="#2196F3" Foreground="White" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="30" Background="#F44336" Foreground="White" Click="DeleteButton_Click"/>
        </StackPanel>

        <!-- Таблица товаров -->
        <DataGrid x:Name="ProductsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#f2f2f2"
                  RowHeight="35">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Цена (₽)" Binding="{Binding Price}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель статистики -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#eeeeee" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Page>
