<Window x:Class="System_product_inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_product_inventory"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="10">
        <DockPanel>
            <!-- Верхняя панель навигации -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#333" Height="45">
                <Button x:Name="ProductsButton" Content="Товары" Width="120" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="ProductsButton_Click"/>
                <Button x:Name="StatsButton" Content="Статистика" Width="120" Foreground="White" Background="Transparent" BorderThickness="0" FontWeight="Bold" Click="StatsButton_Click"/>
            </StackPanel>

            <!-- Контентное окно -->
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </DockPanel>
    </Grid>
</Window>
